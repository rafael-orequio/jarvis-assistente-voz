# Copie este arquivo para .env e preencha. Nunca suba o .env para o GitHub.

# Chave gratuita do Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=cole_sua_chave_aqui

# Modelo principal e reserva (os nomes mudam com o tempo; se der erro 404, troque aqui)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_RESERVA=gemini-3.8-flash

# Voz: tamanho do modelo do Whisper (small = rapido; medium = mais preciso)
# e dispositivo (cpu funciona em qualquer PC; cuda usa a placa NVIDIA, veja requirements-gpu.txt)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# Tecla global, funciona em qualquer janela: ctrl_r, f9, ctrl+space...
JARVIS_TECLA=ctrl_r
# 0 desliga o bip de gravacao e a tecla global
JARVIS_BIP=1
JARVIS_TECLA_GLOBAL=1

# Aviso diario de prazos das tarefas (HH:MM). Deixe vazio para desligar.
JARVIS_AVISO_PRAZOS=09:00
# 0 desliga o som dos lembretes quando nenhuma aba do JARVIS esta aberta
JARVIS_ALERTA_SOM=1

# So e usada se o navegador nao informar sua localizacao
# CIDADE=
